using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading.Tasks;
using Microsoft.EntityFrameworkCore;
using wipmanagement.api.DTOs;
using wipmanagement.api.Data;
using wipmanagement.api.Interfaces.Services;
using wipmanagement.api.Models;

namespace wipmanagement.api.Services
{
    public class NotificationService : INotificationService
    {
        private readonly ApplicationDbContext _context;

        public NotificationService(ApplicationDbContext context)
        {
            _context = context;
        }

        public NotificationService(Repositories.NotificationRepository repo)
        {
            _context = repo.Context;
        }

        public async Task CreateNotificationAsync(Notification notification)
        {
            _context.Notifications.Add(notification);
            await _context.SaveChangesAsync();
        }

        public async Task<NotificationResponseDto> CreateAsync(NotificationCreateDto dto)
        {
            var n = new Notification
            {
                EmployeeId = dto.EmployeeId,
                Title = dto.Title,
                Message = dto.Message,
                Timestamp = DateTime.UtcNow,
                IsRead = false,
                IsDeleted = false
            };

            if (dto.CheckOutId.HasValue)
            {
                n.CheckOutId = dto.CheckOutId.Value;
            }

            if (dto.EmployeeId.HasValue)
            {
                n.RecipientEmployeeId = dto.EmployeeId.Value;
                n.RecipientRole = "Employee";
            }
            else
            {
                n.RecipientRole = "Admin";
            }

            _context.Notifications.Add(n);
            await _context.SaveChangesAsync();

            return new NotificationResponseDto
            {
                NotificationId = n.NotificationId,
                EmployeeId = n.RecipientEmployeeId,
                Title = n.Title,
                Message = n.Message,
                CheckOutId = n.CheckOutId,
                IsRead = n.IsRead,
                Timestamp = n.Timestamp
            };
        }

        public async Task<IEnumerable<NotificationResponseDto>> GetAllForEmployeeAsync(int employeeId)
        {
            var list = await _context.Notifications
                .Where(n => n.RecipientEmployeeId == employeeId && !n.IsDeleted)
                .OrderByDescending(n => n.Timestamp)
                .ToListAsync();

            var enriched = new List<NotificationResponseDto>();
            foreach (var n in list)
            {
                var msg = await EnrichMessageAsync(n);
                enriched.Add(new NotificationResponseDto
                {
                    NotificationId = n.NotificationId,
                    EmployeeId = n.RecipientEmployeeId,
                    Title = n.Title,
                    Message = msg,
                    IsRead = n.IsRead,
                    Timestamp = n.Timestamp
                });
            }

            return enriched;
        }

        public async Task<IEnumerable<NotificationResponseDto>> GetUnreadForEmployeeAsync(int employeeId)
        {
            var list = await _context.Notifications
                .Where(n => n.RecipientEmployeeId == employeeId && !n.IsDeleted && n.IsRead == false)
                .OrderByDescending(n => n.Timestamp)
                .ToListAsync();

            var enriched = new List<NotificationResponseDto>();
            foreach (var n in list)
            {
                var msg = await EnrichMessageAsync(n);
                enriched.Add(new NotificationResponseDto
                {
                    NotificationId = n.NotificationId,
                    EmployeeId = n.RecipientEmployeeId,
                    Title = n.Title,
                    Message = msg,
                    IsRead = n.IsRead,
                    Timestamp = n.Timestamp
                });
            }

            return enriched;
        }

        public async Task<IEnumerable<Notification>> GetNotificationsForRoleAsync(string role, int? employeeId = null)
        {
            var query = _context.Notifications.AsQueryable();
            if (!string.IsNullOrEmpty(role)) query = query.Where(n => n.RecipientRole == role || string.IsNullOrEmpty(n.RecipientRole));
            if (employeeId.HasValue) query = query.Where(n => n.RecipientEmployeeId == employeeId.Value || n.RecipientEmployeeId == null);
            var list = await query.Where(n => !n.IsDeleted).OrderByDescending(n => n.Timestamp).ToListAsync();

            foreach (var n in list)
            {
                n.Message = await EnrichMessageAsync(n);
            }

            return list;
        }

        public async Task<int> GetUnreadCountAsync(string role, int? employeeId = null)
        {
            var query = _context.Notifications.AsQueryable();
            if (!string.IsNullOrEmpty(role)) query = query.Where(n => n.RecipientRole == role || string.IsNullOrEmpty(n.RecipientRole));
            if (employeeId.HasValue) query = query.Where(n => n.RecipientEmployeeId == employeeId.Value || n.RecipientEmployeeId == null);
            return await query.CountAsync(n => !n.IsDeleted && n.IsRead == false);
        }

        public async Task<bool> MarkAsReadAsync(int notificationId)
        {
            var n = await _context.Notifications.FindAsync(notificationId);
            if (n == null) return false;
            n.IsRead = true;
            _context.Notifications.Update(n);
            await _context.SaveChangesAsync();
            return true;
        }

        public async Task<bool> SoftDeleteAsync(int notificationId)
        {
            var n = await _context.Notifications.FindAsync(notificationId);
            if (n == null) return false;
            n.IsDeleted = true;
            _context.Notifications.Update(n);
            await _context.SaveChangesAsync();
            return true;
        }

        private async Task<string> EnrichMessageAsync(Notification n)
        {
            if (n == null) return string.Empty;

            var msg = n.Message ?? string.Empty;

            try
            {
                var empToken = ExtractToken(msg, "Employee");
                if (!string.IsNullOrEmpty(empToken))
                {
                    var emp = await _context.Employees.FirstOrDefaultAsync(e => e.EmployeeCode == empToken);
                    if (emp != null)
                    {
                        msg = msg.Replace($"Employee {empToken}", $"Employee {emp.Name}");
                    }
                }

                var prodToken = ExtractToken(msg, "Product");
                if (!string.IsNullOrEmpty(prodToken))
                {
                    var prod = await _context.Products.FirstOrDefaultAsync(p => p.ProductCode == prodToken);
                    if (prod != null)
                    {
                        msg = msg.Replace($"Product {prodToken}", $"Product {prod.Name}");
                        msg = msg.Replace($"Product: {prodToken}", $"Product: {prod.Name}");
                    }
                }

                if (!msg.Contains("Date:") && n.Timestamp != default)
                {
                    msg = msg + $"\nDate: {n.Timestamp:u}";
                }
            }
            catch
            {
  
            }

            return msg;
        }

        private string ExtractToken(string message, string key)
        {
            if (string.IsNullOrEmpty(message) || string.IsNullOrEmpty(key)) return string.Empty;
            var patterns = new[] { $"{key} ", $"{key}: " };
            foreach (var p in patterns)
            {
                var idx = message.IndexOf(p);
                if (idx >= 0)
                {
                    var start = idx + p.Length;
                
                    var end = message.IndexOfAny(new[] { ' ', '\n', ',', '.' }, start);
                    if (end < 0) end = message.Length;
                    var token = message.Substring(start, end - start).Trim();
                    return token;
                }
            }

            return string.Empty;
        }
    }
}
